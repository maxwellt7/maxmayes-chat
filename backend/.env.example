APP_NAME=chat-with-my-pinecone-backend
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
CORS_ALLOW_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# --- Clerk authentication --------------------------------------------------
# Everything here is environment-driven so the same image runs against a
# development Clerk instance and a live one. Nothing is hardcoded.
#
# CLERK_ISSUER is the only required value: the JWKS URL is derived from it as
# ${CLERK_ISSUER}/.well-known/jwks.json.
#   development: https://literate-jaguar-27.clerk.accounts.dev
#   production:  https://clerk.maxmayes.io
# The two instances have different signing keys, so a token from one is
# correctly rejected by the other.
CLERK_ISSUER=
# Optional override if the JWKS lives somewhere other than the derived path.
CLERK_JWKS_URL=
# Optional PEM public key for fully networkless verification. Takes precedence
# over the JWKS URL.
CLERK_JWT_PUBLIC_KEY=
# Comma-separated frontend origins allowed to mint tokens for this API, checked
# against the token's `azp` claim. Prevents a token issued to another app on the
# same Clerk instance being replayed here.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Used by scripts/check_credentials.py to call the Clerk Backend API. Not used
# on the request path — verification is signature-based and needs no secret.
CLERK_SECRET_KEY=

# --- Authorization ---------------------------------------------------------
# Bootstrap allowlist for the owner role. Roles live in the `user_accounts`
# table, never in token claims.
#
# OWNER_CLERK_USER_IDS is the one to set. It matches the token's `sub` claim,
# which is always present and not user-editable. Comma-separated.
OWNER_CLERK_USER_IDS=
# OWNER_EMAILS only works if this Clerk instance's JWT template adds an email
# claim to session tokens — Clerk does not include one by default. Best-effort.
OWNER_EMAILS=
#
# Setting OWNER_CLERK_USER_IDS after the owner has already signed up still
# works: startup reconciliation promotes matching accounts on every boot, and
# `python -m app.scripts.grant_owner <clerk_user_id>` does it without a restart.

# --- Cost containment ------------------------------------------------------
# Global daily ceiling on estimated LLM spend, in USD, enforced in Postgres and
# checked before the synthesis call. Deliberately low by default: raising it is
# one variable, whereas an unnoticed overspend is not recoverable. Set to 0 as a
# kill switch.
DAILY_SPEND_CEILING_USD=10.0

# Token-bucket rate limits. `BURST` is bucket capacity (back-to-back requests
# from cold); the hourly figure sets the refill rate. The per-IP allowance is
# looser because addresses are shared behind NAT.
CHAT_RATE_LIMIT_PER_ACCOUNT_PER_HOUR=60
CHAT_RATE_LIMIT_BURST=5
CHAT_RATE_LIMIT_PER_IP_PER_HOUR=120
CHAT_RATE_LIMIT_IP_BURST=20
# Salt for hashing client IPs before storage. Change this per environment.
IP_HASH_SALT=change-me
# Believe X-Forwarded-For. Correct behind a proxy such as Railway, where
# request.client.host is the proxy. Also means the header is spoofable, so
# per-account limits and the spend ceiling are the real controls.
TRUST_FORWARDED_FOR=true

# --- Providers -------------------------------------------------------------
PINECONE_API_KEY_1=
PINECONE_API_KEY_2=
PINECONE_API_KEY_3=

OPENAI_API_KEY=
COHERE_API_KEY=
# Required at runtime by the synthesis stage.
ANTHROPIC_API_KEY=
